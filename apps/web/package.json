{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "routes:generate": "node scripts/generate-routes.mjs",
    "routes:watch": "node scripts/generate-routes.mjs --watch",
    "dev": "concurrently -k \"pnpm routes:watch\" \"next dev --hostname 0.0.0.0\"",
    "build": "pnpm routes:generate && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^1.50.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.9.0"
}
