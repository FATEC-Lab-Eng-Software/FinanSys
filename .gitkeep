Get-ChildItem -Recurse -Filter ".gitkeep" | Remove-Item -Force

$serverFolders = @(
    "apps\server\src\core",
    "apps\server\src\models",
    "apps\server\src\schemas",
    "apps\server\src\repositories",
    "apps\server\src\services",
    "apps\server\src\routers",
    "apps\server\alembic"
)
foreach ($folder in $serverFolders) {
    if (!(Test-Path $folder)) { New-Item -ItemType Directory -Force -Path $folder | Out-Null }
    New-Item -Path "$folder\__init__.py" -ItemType File -Force | Out-Null
}

$webFolders = @(
    "apps\web\src\app\(auth)\login",
    "apps\web\src\app\(auth)\register",
    "apps\web\src\app\(dashboard)\dashboard",
    "apps\web\src\app\(dashboard)\transactions",
    "apps\web\src\components\ui",
    "apps\web\src\components\layout",
    "apps\web\src\services",
    "apps\web\src\hooks",
    "apps\web\src\store",
    "apps\web\src\types",
    "apps\web\src\utils",
    "apps\web\public"
)
foreach ($folder in $webFolders) {
    if (!(Test-Path $folder)) { New-Item -ItemType Directory -Force -Path $folder | Out-Null }
    Set-Content -Path "$folder\README.md" -Value "# Pasta de $(Split-Path $folder -Leaf)"
}